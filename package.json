{
  "name": "atelier-juridique-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "vite build --configLoader native",
    "start": "node server/index.mjs --production",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "build:ui": "vite build --ssr src/App.jsx --outDir test-results/ui --configLoader native",
    "test:ui": "node tests/ui.mjs",
    "demo:redline": "node scripts/exemple-redline.mjs",
    "format": "prettier --write src server scripts tests vite.config.mjs package.json README.md"
  },
  "dependencies": {
    "docx": "9.12.0",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "lucide-react": "1.59.0",
    "mammoth": "1.13.0",
    "multer": "2.4.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "jszip": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "vite": "8.3.4"
  }
}
